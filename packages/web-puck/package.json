{
  "name": "@repo/web-puck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@puckeditor/core": "0.24.0",
    "@repo/web-components": "workspace:*",
    "@repo/web-schema": "workspace:*",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.2",
    "react": "19.2.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
